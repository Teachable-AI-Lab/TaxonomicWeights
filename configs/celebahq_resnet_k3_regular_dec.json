{
  "_comment": "ResNet-style taxonomic encoder (k=3) with regular (non-taxonomic) decoder. Decoder channel counts match taxonomic variant: n_layers=7→254, 6→126, 5→62, 5→62.",
  "description": "ResNet Taxonomic Encoder + Regular Decoder CelebA-HQ AE (k=3): 4 taxon_conv encoder layers (256->16, n_layers 5/6/7/4) and 4 regular deconv decoder layers (16->256, n_filters 254/126/62/62). KL regularized encoder only.",
  "experiment_name": "celebahq_resnet_k3_regular_dec",
  "data": {
    "data_root": "./data/celeba_hq",
    "image_size": 128,
    "batch_size": 128,
    "num_workers": 4,
    "val_split": 0.1,
    "train_subset": null,
    "val_subset": null,
    "_comment_subset": "batch_size=128; small (3x3) kernels with residual blocks."
  },
  "model": {
    "latent_dim": 30,
    "temperature": 1.0,
    "use_maxpool": false,
    "output_activation": "sigmoid",
    "encoder_layers": [
      {
        "layer_type": "taxon_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "256x256x3 -> stride2 -> 128x128x62  (5 depth levels, 62ch)"
      },
      {
        "layer_type": "taxon_conv",
        "n_layers": 6,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "128x128x62 -> stride2 -> 64x64x126  (6 depth levels, 126ch)"
      },
      {
        "layer_type": "taxon_conv",
        "n_layers": 7,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "64x64x126 -> stride2 -> 32x32x254  (7 depth levels, 254ch)"
      },
      {
        "layer_type": "taxon_conv",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "32x32x254 -> stride2 -> 16x16x30  BOTTLENECK (4 depth, 30ch = 7,680 vals, ~25.6x compression)"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "deconv",
        "n_filters": 254,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "16x16x30 -> 32x32x254  (matches taxon_deconv n_layers=7)"
      },
      {
        "layer_type": "deconv",
        "n_filters": 126,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "32x32x254 -> 64x64x126  (matches taxon_deconv n_layers=6)"
      },
      {
        "layer_type": "deconv",
        "n_filters": 62,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "64x64x126 -> 128x128x62  (matches taxon_deconv n_layers=5)"
      },
      {
        "layer_type": "deconv",
        "n_filters": 62,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "128x128x62 -> 256x256x62, then final_conv -> 256x256x3  (matches taxon_deconv n_layers=5)"
      }
    ]
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.0003,
    "entropy_weight": 0,
    "batch_kl_weight": 0.001,
    "_comment": "entropy_weight/batch_kl_weight: only encoder is taxonomic so regularization comes from encoder KL only."
  },
  "analysis": {
    "checkpoint_path": "outputs/celebahq/training/celebahq_resnet_k3_regular_dec/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/celebahq/training/celebahq_resnet_k3_regular_dec",
    "analysis_save_dir": "outputs/celebahq/analysis/celebahq_resnet_k3_regular_dec"
  }
}
