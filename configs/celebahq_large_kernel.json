{
  "_comment": "Large kernel (k=13) — bottleneck tightened to 16x16x31 (7,936 values, ~25x compression). Added a 4th strided encoder layer so spatial size reaches 16x16 before the bottleneck squeeze.",
  "description": "Large Kernel CelebA-HQ Taxonomic Autoencoder (k=13): 4 encoder layers (256x256->16x16) and 4 decoder layers (16x16->256x256). Bottleneck: 16x16x31=7,936 values (~25x compression).",
  "experiment_name": "celebahq_large_kernel",
  "data": {
    "data_root": "./data/celeba_hq",
    "batch_size": 32,
    "num_workers": 4,
    "val_split": 0.1,
    "train_subset": null,
    "val_subset": null,
    "_comment_subset": "Set train_subset/val_subset to an integer (e.g., 5000) to train on a smaller subset for faster iteration. null = use full dataset"
  },
  "model": {
    "latent_dim": 31,
    "temperature": 1.0,
    "use_maxpool": false,
    "output_activation": "sigmoid",
    "encoder_layers": [
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "_comment": "256x256x3 -> stride2 -> 128x128x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "_comment": "128x128x63 -> stride2 -> 64x64x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "_comment": "64x64x63 -> stride2 -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 4,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "_comment": "32x32x63 -> stride2 -> 16x16x31 (BOTTLENECK: 16x16x31=7,936 values, ~25x compression)"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "output_padding": 1,
        "_comment": "16x16x31 -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "output_padding": 1,
        "_comment": "32x32x63 -> 64x64x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "output_padding": 1,
        "_comment": "64x64x63 -> 128x128x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 13,
        "stride": 2,
        "padding": 6,
        "output_padding": 1,
        "_comment": "128x128x63 -> 256x256x63, then final conv to 256x256x3"
      }
    ]
  },
  "training": {
    "epochs": 30,
    "learning_rate": 0.0003  },
  "analysis": {
  "checkpoint_path": "outputs/celebahq/training/celebahq_large_kernel/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/celebahq/training/celebahq_large_kernel",
    "analysis_save_dir": "outputs/celebahq/analysis/celebahq_large_kernel"
  }
}