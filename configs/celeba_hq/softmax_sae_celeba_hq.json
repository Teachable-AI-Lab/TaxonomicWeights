{
  "experiment_name": "sae_softmax_celeba_hq_r18",
  "model": {
    "model_variant":    "softmax_sae",
    "resnet_variant":   "18",
    "stage_channels":   [62, 126, 254, 510],
    "stage_strides":    [1, 2, 2, 2],
    "temperature":      1.0,
    "stem_stride":      2,
    "use_stem_maxpool": true,
    "output_activation": "none"
  },
  "data": {
    "data_root":   "./data/celeba_hq",
    "image_size":  256,
    "batch_size":  32,
    "num_workers": 8,
    "val_split":   0.05
  },
  "training": {
    "epochs":         90,
    "learning_rate":  3e-4,
    "weight_decay":   1e-4,
    "warmup_epochs":  3,
    "dkl_weight":     1e-2,
    "entropy_weight": 0.0,
    "save_every":     5,
    "seed":           42
  },
  "output": {
    "output_dir":        "./outputs/celeba_hq/sae_softmax_celeba_hq_r18",
    "analysis_save_dir": "./outputs/celeba_hq/sae_softmax_celeba_hq_r18/analysis"
  }
}
