{
  "experiment_name": "sae_matryoshka_batch_topk_celeba_hq_r18_small",
  "model": {
    "model_variant":   "matryoshka_batch_topk",
    "resnet_variant":  "18",
    "stage_channels":  [32, 64, 128, 256],
    "stage_strides":   [1, 2, 2, 2],
    "k_values":        [8, 4, 2],
    "k_aux":           8,
    "use_aux_loss":    true,
    "dead_threshold":  0.001,
    "stem_stride":     2,
    "use_stem_maxpool":true,
    "output_activation": "none"
  },
  "data": {
    "data_root":   "./data/celeba_hq",
    "image_size":  256,
    "batch_size":  32,
    "num_workers": 8,
    "val_split":   0.05
  },
  "training": {
    "epochs":          90,
    "learning_rate":   3e-4,
    "weight_decay":    1e-4,
    "warmup_epochs":   3,
    "sparsity_weight": 1e-2,
    "loss_weights":    [1.0, 0.5, 0.25],
    "save_every":      5,
    "seed":            42
  },
  "output": {
    "output_dir":       "./outputs/celeba_hq/sae_matryoshka_batch_topk_celeba_hq_r18_small",
    "analysis_save_dir":"./outputs/celeba_hq/sae_matryoshka_batch_topk_celeba_hq_r18_small_k8-4-2_sw1e-02/analysis"
  }
}
