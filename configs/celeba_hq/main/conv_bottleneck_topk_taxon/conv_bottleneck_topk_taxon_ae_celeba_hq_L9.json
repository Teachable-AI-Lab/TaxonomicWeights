        "output_activation": "none",
        "k_leaves": 1,
        "use_gate_value": false
    },
    "training": {
        "epochs": 90,
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "warmup_epochs": 3,
        "auxk_weight": 0.01,
        "dkl_weight": 0.01,
        "decoder_max_norm": 1.0,
        "save_every": 5,
        "seed": 42,
        "max_train_steps": 0
    },
    "output": {
        "output_dir": "./outputs/celeba_hq/main/conv_bottleneck_topk_taxon_ae_celeba_hq"
    }
