{
    "experiment_name": "conv_bottleneck_topk_taxon_ae_celeba_hq_L9",
    "data": {
        "data_root": "./data/celeba_hq",
        "image_size": 256,
        "batch_size": 32,
        "num_workers": 8,
        "val_split": 0.05
    },
    "model": {
        "in_channels": 3,
        "bottleneck_n_taxonomy_layers": 9,
        "bottleneck_n_blocks": 1,
        "topk_k_multiplier": 1.0,
        "dead_steps": 2000,
        "temperature": 0.5,
        "hard": false,
