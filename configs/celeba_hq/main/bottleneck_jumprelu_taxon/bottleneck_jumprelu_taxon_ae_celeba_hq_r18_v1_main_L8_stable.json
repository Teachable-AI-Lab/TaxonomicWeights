{
    "experiment_name": "bottleneck_jumprelu_taxon_ae_celeba_hq_r18_v1_main_L8_stable",
    "data": {
        "data_root": "./data/celeba_hq",
        "image_size": 256,
        "batch_size": 32,
        "num_workers": 8,
        "val_split": 0.05
    },
    "model": {
        "in_channels": 3,
        "plain_stage_channels": [64, 128, 256],
        "plain_stage_blocks": [2, 2, 2],
        "plain_stage_strides": [1, 2, 2],
        "bottleneck_n_taxonomy_layers": 8,
        "bottleneck_n_blocks": 2,
        "bottleneck_stride": 2,
        "target_l0": 8.0,
        "bandwidth": 0.01,
        "theta_init": 0.001,
        "l0_surrogate_temp": 1.0,
        "kernel_size": 3,
        "use_stem": true,
        "stem_channels": 64,
        "stem_stride": 2,
        "use_stem_maxpool": true,
        "output_activation": "none",
        "temperature": 1.0,
        "hard": false,
        "depth_decay": 0.5,
        "gumbel": true,
        "resample_min_count": 5
    },
    "training": {
        "epochs": 90,
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "warmup_epochs": 3,
        "sparsity_weight": 0.05,
        "dkl_weight": 0.0,
        "decoder_max_norm": 1.0,
        "save_every": 5,
        "seed": 42,
        "max_train_steps": 0,
        "tau_start": 1.0,
        "tau_end": 0.1,
        "tau_anneal_frac": 0.5,
        "balance_weight": 0.1,
        "resample_interval": 500
    },
    "output": {
        "output_dir": "./outputs/celeba_hq/main/bottleneck_jumprelu_taxon_ae_celeba_hq_r18_v1_main_stable"
    }
}
