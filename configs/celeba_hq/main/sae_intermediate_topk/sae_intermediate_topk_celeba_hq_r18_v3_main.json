{
    "experiment_name": "sae_intermediate_topk_celeba_hq_r18_v3_main",
    "data": {
        "data_root": "./data/celeba_hq",
        "image_size": 256,
        "batch_size": 16,
        "num_workers": 8,
        "val_split": 0.05
    },
    "model": {
        "in_channels": 3,
        "resnet_variant": "18",
        "stage_channels": [62, 126, 254, 510],
        "stage_strides": [1, 2, 2, 2],
        "stage_blocks": null,
        "k_values": [5, 6, 7, 8],
        "k_aux": 8,
        "use_aux_loss": true,
        "dead_threshold": 1e-3,
        "kernel_size": 3,
        "use_stem": true,
        "stem_channels": 64,
        "stem_stride": 2,
        "use_stem_maxpool": true,
        "output_activation": "none"
    },
    "training": {
        "epochs": 90,
        "learning_rate": 3e-4,
        "weight_decay": 1e-4,
        "warmup_epochs": 3,
        "sparsity_weight": 1e-2,
        "loss_weights": [0.25, 0.5, 1.0, 2.0],
        "save_every": 5,
        "seed": 42,
        "max_train_steps": 0
    },
    "output": {
        "output_dir": "./outputs/celeba_hq/main/sae_intermediate_topk_celeba_hq_r18_v3_main"
    }
}
