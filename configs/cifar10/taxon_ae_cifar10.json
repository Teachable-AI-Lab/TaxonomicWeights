{
  "experiment_name": "taxon_ae_cifar10_r18",
  "data": {
    "data_root": "./data",
    "image_size": 32,
    "batch_size": 128,
    "num_workers": 4,
    "val_split": 0.1
  },
  "model": {
    "in_channels": 3,
    "resnet_variant": "18",
    "stage_taxonomy_layers": [5, 6, 7, 8],
    "stage_strides": [1, 2, 2, 2],
    "stage_blocks": null,
    "temperature": 0.5,
    "hard": false,
    "kernel_size": 3,
    "use_stem": true,
    "stem_channels": 64,
    "stem_stride": 1,
    "use_stem_maxpool": false,
    "output_activation": "none",
    "depth_decay": 0.5
  },
  "training": {
    "epochs": 90,
    "learning_rate": 3e-4,
    "weight_decay": 1e-4,
    "warmup_epochs": 3,
    "dkl_weight": 1e-2,
    "entropy_weight": 0.0,
    "save_every": 5,
    "seed": 42,
    "max_train_steps": 0
  },
  "output": {
    "output_dir": "./outputs/cifar10/taxon_ae_cifar10_r18",
    "analysis_save_dir": "./outputs/cifar10/taxon_ae_cifar10_r18/analysis"
  }
}
