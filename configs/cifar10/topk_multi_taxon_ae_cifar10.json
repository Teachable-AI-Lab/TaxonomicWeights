{
  "experiment_name": "topk_multi_taxon_ae_cifar10_r18",
  "data": {
    "data_root": "./data",
    "image_size": 32,
    "batch_size": 128,
    "num_workers": 4,
    "val_split": 0.1
  },
  "model": {
    "in_channels": 3,
    "resnet_variant": "18",
    "stage_taxonomy_layers": [3, 4, 5, 6],
    "stage_strides": [1, 2, 2, 2],
    "stage_blocks": null,
    "n_hierarchies": 3,
    "k_aux": null,
    "dead_steps": 2000,
    "gate_k": 1,
    "kernel_size": 3,
    "use_stem": true,
    "stem_channels": 64,
    "stem_stride": 1,
    "use_stem_maxpool": false,
    "output_activation": "none",
    "temperature": 0.5,
    "depth_decay": 0.5
  },
  "training": {
    "epochs": 90,
    "learning_rate": 3e-4,
    "weight_decay": 1e-4,
    "warmup_epochs": 3,
    "auxk_weight": 1e-2,
    "save_every": 5,
    "seed": 42,
    "max_train_steps": 0
  },
  "analysis": {
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3,
    "num_taxonomy_batches": 10
  },
  "output": {
    "output_dir": "./outputs/cifar10/topk_multi_taxon_ae_cifar10_r18"
  }
}
