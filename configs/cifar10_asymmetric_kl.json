{
  "_comment": "KL autoencoder — strong spatial bottleneck at 4x4x30 (480 values, ~6x compression of 3072 input pixels)",
  "description": "Asymmetric CIFAR-10 KL Taxonomic Autoencoder: 4 encoder layers (32x32->4x4) and 3 decoder layers (4x4->32x32). Bottleneck: 4x4x30=480 values (~6x compression).",
  "experiment_name": "asymmetric_kl_no_linear_ar",
  "data": {
    "batch_size": 128,
    "data_root": "./data/cifar10"
  },
  "model": {
    "latent_dim": 30,
    "temperature": 1.0,
    "use_maxpool": true,
    "encoder_layers": [
      {
        "layer_type": "taxonomic_conv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "32x32x3 -> MaxPool(2) -> 16x16x30  (KL: 2+4+8+16=30)"
      },
      {
        "layer_type": "taxonomic_conv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "16x16x30 -> MaxPool(2) -> 8x8x30"
      },
      {
        "layer_type": "taxonomic_conv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "8x8x30 -> MaxPool(2) -> 4x4x30"
      },
      {
        "layer_type": "taxonomic_conv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "4x4x30 -> 4x4x30 (BOTTLENECK: 4x4x30=480 values, ~6x compression)"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "taxonomic_deconv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "4x4x30 -> 8x8x30"
      },
      {
        "layer_type": "taxonomic_deconv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "8x8x30 -> 16x16x30"
      },
      {
        "layer_type": "taxonomic_deconv_kl",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "16x16x30 -> 32x32x30, then final conv to 32x32x3"
      }
    ]
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.001,
    "kl_weight": 0.001,
    "_comment": "kl_weight=0.001: light regularisation so reconstruction dominates."
  },
  "analysis": {
    "checkpoint_path": "outputs/cifar10/training/asymmetric_kl_no_linear_ar/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/cifar10/training/asymmetric_kl_no_linear_ar",
    "analysis_save_dir": "outputs/cifar10/analysis/asymmetric_kl_no_linear_ar"
  }
}
