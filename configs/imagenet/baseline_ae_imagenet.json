{
    "experiment_name": "baseline_ae_imagenet_r18",
    "data": {
        "data_root": "./data/tiny_imagenet",
        "image_size": 64,
        "batch_size": 32,
        "num_workers": 8
    },
    "model": {
        "in_channels": 3,
        "resnet_variant": "18",
        "stage_channels": [
            64,
            128,
            256,
            512
        ],
        "stage_strides": [
            1,
            2,
            2,
            2
        ],
        "stage_blocks": null,
        "kernel_size": 3,
        "use_stem": true,
        "stem_channels": 64,
        "stem_stride": 2,
        "use_stem_maxpool": true,
        "output_activation": "none"
    },
    "training": {
        "epochs": 90,
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "warmup_epochs": 3,
        "save_every": 5,
        "seed": 42,
        "max_train_steps": 0
    },
    "output": {
        "output_dir": "./outputs/imagenet/baseline_ae_imagenet_r18",
        "analysis_save_dir": "./outputs/imagenet/baseline_ae_imagenet_r18/analysis"
    }
}
