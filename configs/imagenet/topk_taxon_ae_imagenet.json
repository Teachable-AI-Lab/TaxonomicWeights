{
  "experiment_name": "topk_taxon_ae_imagenet_r18",
  "data": {
    "data_root": "./data/imagenet",
    "image_size": 224,
    "batch_size": 32,
    "num_workers": 8,
    "val_split": 0.0,
    "max_train_samples": 100000,
    "max_val_samples": 10000
  },
  "model": {
    "in_channels": 3,
    "resnet_variant": "18",
    "stage_taxonomy_layers": [
      5,
      6,
      7,
      8
    ],
    "stage_strides": [
      2,
      2,
      2,
      2
    ],
    "stage_blocks": null,
    "k_aux": null,
    "dead_steps": 2000,
    "kernel_size": 3,
    "use_stem": true,
    "stem_channels": 64,
    "stem_stride": 2,
    "use_stem_maxpool": true,
    "output_activation": "none",
    "temperature": 0.5,
    "depth_decay": 0.5
  },
  "training": {
    "epochs": 90,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "warmup_epochs": 3,
    "auxk_weight": 0.01,
    "save_every": 5,
    "seed": 42,
    "max_train_steps": 0
  },
  "analysis": {
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3,
    "num_taxonomy_batches": 10
  },
  "output": {
    "output_dir": "./outputs/imagenet/topk_taxon_ae_imagenet_r18"
  }
}
