{
  "experiment_name": "sae_matryoshka_batch_topk_imagenet_r18",
  "model": {
    "model_variant":   "matryoshka_batch_topk",
    "resnet_variant":  "18",
    "stage_channels":  [64, 128, 256, 512],
    "stage_strides":   [2, 2, 2, 2],
    "k_values":        [8, 4, 2],
    "k_aux":           8,
    "use_aux_loss":    true,
    "dead_threshold":  0.001,
    "stem_stride":     2,
    "use_stem_maxpool":true,
    "output_activation": "none"
  },
  "data": {
    "data_root":          "./data/imagenet",
    "image_size":         224,
    "batch_size":         32,
    "num_workers":        8,
    "max_train_samples":  100000,
    "max_val_samples":    10000
  },
  "training": {
    "epochs":          90,
    "learning_rate":   3e-4,
    "weight_decay":    1e-4,
    "warmup_epochs":   3,
    "sparsity_weight": 1e-2,
    "loss_weights":    [1.0, 0.5, 0.25],
    "save_every":      5,
    "seed":            42
  },
  "output": {
    "output_dir":       "./outputs/imagenet/sae_matryoshka_batch_topk_imagenet_r18",
    "analysis_save_dir":"./outputs/imagenet/sae_matryoshka_batch_topk_imagenet_r18/analysis"
  }
}
