{
  "experiment_name": "sae_softmax_imagenet_r18",
  "model": {
    "model_variant":    "softmax_sae",
    "resnet_variant":   "18",
    "stage_channels":   [64, 128, 256, 512],
    "stage_strides":    [2, 2, 2, 2],
    "temperature":      1.0,
    "stem_stride":      2,
    "use_stem_maxpool": true,
    "output_activation": "none"
  },
  "data": {
    "data_root":          "./data/imagenet",
    "image_size":         224,
    "batch_size":         32,
    "num_workers":        8,
    "val_split":          0.0,
    "max_train_samples":  100000,
    "max_val_samples":    10000
  },
  "training": {
    "epochs":         90,
    "learning_rate":  3e-4,
    "weight_decay":   1e-4,
    "warmup_epochs":  3,
    "dkl_weight":     1e-2,
    "entropy_weight": 0.0,
    "save_every":     5,
    "seed":           42
  },
  "output": {
    "output_dir":        "./outputs/imagenet/sae_softmax_imagenet_r18",
    "analysis_save_dir": "./outputs/imagenet/sae_softmax_imagenet_r18/analysis"
  }
}
