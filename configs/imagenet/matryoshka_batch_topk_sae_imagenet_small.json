{
    "experiment_name": "sae_matryoshka_batch_topk_imagenet_r18_small",
    "model": {
        "model_variant": "matryoshka_batch_topk",
        "resnet_variant": "18",
        "stage_channels": [
            32,
            64,
            128,
            256
        ],
        "stage_strides": [
            1,
            2,
            2,
            2
        ],
        "k_values": [
            8,
            4,
            2
