            1.0,
            0.5,
            0.25
        ],
        "save_every": 5,
        "seed": 42
    },
    "output": {
        "output_dir": "./outputs/imagenet/sae_matryoshka_batch_topk_imagenet_r18_small",
        "analysis_save_dir": "./outputs/imagenet/sae_matryoshka_batch_topk_imagenet_r18_small_k8-4-2_sw1e-02/analysis"
