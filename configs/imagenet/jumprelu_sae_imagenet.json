{
  "experiment_name": "sae_jumprelu_imagenet_r18",
  "data": {
    "data_root": "./data/imagenet",
    "image_size": 224,
    "batch_size": 32,
    "num_workers": 8,
    "val_split": 0.0,
    "max_train_samples": 100000,
    "max_val_samples": 10000
  },
  "model": {
    "model_variant": "jumprelu",
    "in_channels": 3,
    "resnet_variant": "18",
    "stage_channels": [
      64,
      128,
      256,
      512
    ],
    "stage_strides": [
      2,
      2,
      2,
      2
    ],
    "stage_blocks": null,
    "target_l0": 64,
    "bandwidth": 0.001,
    "theta_init": 0.1,
    "kernel_size": 3,
    "use_stem": true,
    "stem_channels": 64,
    "stem_stride": 2,
    "use_stem_maxpool": true,
    "output_activation": "none"
  },
  "training": {
    "epochs": 90,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "warmup_epochs": 3,
    "sparsity_weight": 0.01,
    "save_every": 5,
    "seed": 42,
    "max_train_steps": 0
  },
  "output": {
    "output_dir": "./outputs/imagenet/sae_jumprelu_imagenet_r18",
    "analysis_save_dir": "./outputs/imagenet/sae_jumprelu_imagenet_r18/analysis"
  }
}
