{
  "experiment_name": "sae_topk_cifar10_r18",
  "data": {
    "data_root": "./data/cifar10",
    "image_size": 32,
    "batch_size": 128,
    "num_workers": 4,
    "val_split": 0.1
  },
  "model": {
    "model_variant": "topk",
    "in_channels": 3,
    "resnet_variant": "18",
    "stage_channels": [64, 128, 256, 512],
    "stage_strides": [1, 2, 2, 2],
    "stage_blocks": null,
    "topk_k": 64,
    "k_aux": 64,
    "use_aux_loss": true,
    "dead_threshold": 0.001,
    "kernel_size": 3,
    "use_stem": true,
    "stem_channels": 64,
    "stem_stride": 1,
    "use_stem_maxpool": false,
    "output_activation": "none"
  },
  "training": {
    "epochs": 90,
    "learning_rate": 3e-4,
    "weight_decay": 1e-4,
    "warmup_epochs": 3,
    "sparsity_weight": 1e-2,
    "save_every": 5,
    "seed": 42,
    "max_train_steps": 0
  },
  "output": {
    "output_dir": "./outputs/sae_topk_cifar10_r18",
    "analysis_save_dir": "./outputs/sae_topk_cifar10_r18/analysis"
  }
}
