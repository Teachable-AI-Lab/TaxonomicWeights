{
  "_comment": "Deep block architecture — bottleneck tightened to 16x16x31 (7,936 values, ~25x compression). 4 encoder blocks (refine+stride), decoder mirrors with upsample+refine.",
  "description": "CelebA-HQ Deep Block Taxonomic Autoencoder: 8 encoder layers (4 blocks × 2, 256x256->16x16) and 8 decoder layers (4 blocks × 2). Bottleneck: 16x16x31=7,936 (~25x compression).",
  "experiment_name": "celebahq_deep_blocks",
  "data": {
    "data_root": "./data/celeba_hq",
    "batch_size": 32,
    "num_workers": 4,
    "val_split": 0.1,
    "train_subset": null,
    "val_subset": null,
    "_comment_subset": "batch_size reduced to 32 for memory efficiency with deep blocks."
  },
  "model": {
    "latent_dim": 31,
    "temperature": 1.0,
    "use_maxpool": true,
    "output_activation": "sigmoid",
    "encoder_layers": [
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Block 1a (refine): 256x256x3 -> 256x256x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 1b (stride): 256x256x63 -> MaxPool -> 128x128x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Block 2a (refine): 128x128x63 -> 128x128x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 2b (stride): 128x128x63 -> MaxPool -> 64x64x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Block 3a (refine): 64x64x63 -> 64x64x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 3b (stride): 64x64x63 -> MaxPool -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 4a (stride): 32x32x63 -> MaxPool -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Block 4b (bottleneck refine): 16x16x63 -> 16x16x31 (BOTTLENECK: 16x16x31=7,936 values, ~25x compression)"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 1 (upsample): 16x16x31 -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_padding": 0,
        "_comment": "Block 1 (refine): 32x32x63 -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 2 (upsample): 32x32x63 -> 64x64x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_padding": 0,
        "_comment": "Block 2 (refine): 64x64x63 -> 64x64x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 3 (upsample): 64x64x63 -> 128x128x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_padding": 0,
        "_comment": "Block 3 (refine): 128x128x63 -> 128x128x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 4 (upsample): 128x128x63 -> 256x256x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_padding": 0,
        "_comment": "Block 4 (refine): 256x256x63 -> 256x256x63, then final conv to 256x256x3"
      }
    ]
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.001
  },
  "analysis": {
    "checkpoint_path": "outputs/celebahq/training/celebahq_deep_blocks/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/celebahq/training/celebahq_deep_blocks",
    "analysis_save_dir": "outputs/celebahq/analysis/celebahq_deep_blocks"
  }
}
