{
  "_comment": "Deep block architecture — bottleneck tightened to 4x4x31 (496 values, ~6x compression). Two conv blocks downsample 32->8, a third block further compresses to 4x4x31.",
  "description": "Deep CIFAR-10 Taxonomic Autoencoder: 3 encoder conv-blocks (stride-2) + bottleneck conv (stride-2+refine), decoder mirrors with upsample+refine. Bottleneck: 4x4x31=496 values (~6x compression).",
  "experiment_name": "deep_blocks_taxonomic",
  "data": {
    "batch_size": 128,
    "data_root": "./data/cifar10"
  },
  "model": {
    "latent_dim": 31,
    "temperature": 1.0,
    "use_maxpool": true,
    "encoder_layers": [
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Block 1a (refine): 32x32x3 -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 1b (stride): 32x32x63 -> MaxPool -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Block 2a (refine): 16x16x63 -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 2b (stride): 16x16x63 -> MaxPool -> 8x8x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "Block 3 (stride): 8x8x63 -> MaxPool -> 4x4x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 4,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "_comment": "Bottleneck refine: 4x4x63 -> 4x4x31 (BOTTLENECK: 4x4x31=496 values, ~6x compression)"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 1 (upsample): 4x4x31 -> 8x8x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 2 (upsample): 8x8x63 -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_padding": 0,
        "_comment": "Block 2 (refine): 16x16x63 -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "Block 3 (upsample): 16x16x63 -> 32x32x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1,
        "output_padding": 0,
        "_comment": "Block 3 (refine): 32x32x63 -> 32x32x63, then final conv to 32x32x3"
      }
    ]
  },
  "training": {
    "epochs": 30,
    "learning_rate": 0.001
  },
  "analysis": {
    "checkpoint_path": "outputs/cifar10/training/deep_blocks_taxonomic/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/cifar10/training/deep_blocks_taxonomic",
    "analysis_save_dir": "outputs/cifar10/analysis/deep_blocks_taxonomic"
  }
}
