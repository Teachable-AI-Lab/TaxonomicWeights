{
  "_comment": "ResNet-style taxonomic AE (k=3) with linear bottleneck on 128x128 CelebA-HQ. Encoder: 4 stride-2 TaxonConv layers (128->8 spatial, 62->510ch) -> flatten -> fc(32640,256). Decoder: fc(256,32640) -> reshape 510x8x8 -> 4 stride-2 TaxonDeconv layers (8->128 spatial) -> conv->3ch.",
  "description": "ResNet Taxonomic CelebA-HQ AE (k=3, 128x128): linear bottleneck (256-d latent). Encoder n_layers 5/6/7/8, Decoder n_layers 8/7/6/5.",
  "experiment_name": "celebahq_resnet_k3_linear",
  "data": {
    "data_root": "./data/celeba_hq",
    "image_size": 128,
    "batch_size": 64,
    "num_workers": 4,
    "val_split": 0.1,
    "train_subset": null,
    "val_subset": null,
    "_comment_subset": "128x128; k=3 kernels; linear bottleneck to 256-d latent."
  },
  "model": {
    "latent_dim": 256,
    "temperature": 1.0,
    "use_maxpool": false,
    "use_linear_bottleneck": true,
    "output_activation": "sigmoid",
    "encoder_layers": [
      {
        "layer_type": "taxon_conv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "128x128x3 -> 64x64x62  (5 depth, 62ch)"
      },
      {
        "layer_type": "taxon_conv",
        "n_layers": 6,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "64x64x62 -> 32x32x126  (6 depth, 126ch)"
      },
      {
        "layer_type": "taxon_conv",
        "n_layers": 7,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "32x32x126 -> 16x16x254  (7 depth, 254ch)"
      },
      {
        "layer_type": "taxon_conv",
        "n_layers": 8,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "_comment": "16x16x254 -> 8x8x510  (8 depth, 510ch) -> flatten 32640 -> fc -> 256 latent"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "taxon_deconv",
        "n_layers": 8,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "fc 256->32640 -> reshape 510x8x8 -> 16x16x510  (8 depth, 510ch)"
      },
      {
        "layer_type": "taxon_deconv",
        "n_layers": 7,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "16x16x510 -> 32x32x254  (7 depth, 254ch)"
      },
      {
        "layer_type": "taxon_deconv",
        "n_layers": 6,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "32x32x254 -> 64x64x126  (6 depth, 126ch)"
      },
      {
        "layer_type": "taxon_deconv",
        "n_layers": 5,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "output_padding": 1,
        "_comment": "64x64x126 -> 128x128x62  (5 depth, 62ch) -> final_conv -> 128x128x3"
      }
    ]
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.0003,
    "entropy_weight": 0.001,
    "batch_kl_weight": 0.001,
    "_comment": "Both regularizers active: entropy for sparse per-instance routing, batch_kl for branch diversity."
  },
  "analysis": {
    "checkpoint_path": "outputs/celebahq/training/celebahq_resnet_k3_linear/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/celebahq/training/celebahq_resnet_k3_linear",
    "analysis_save_dir": "outputs/celebahq/analysis/celebahq_resnet_k3_linear"
  }
}
