{
  "_comment": "Large kernel (k=7) for wide receptive fields — bottleneck tightened to 4x4x31 (496 values, ~6x compression). Wide kernels now compress aggressively.",
  "description": "Large Kernel CIFAR-10 Taxonomic Autoencoder (k=7): 4 encoder layers (32x32->4x4) and 3 decoder layers (4x4->32x32). Bottleneck: 4x4x31=496 values (~6x compression).",
  "experiment_name": "large_kernel_k7",
  "data": {
    "batch_size": 128,
    "data_root": "./data/cifar10"
  },
  "model": {
    "latent_dim": 31,
    "temperature": 1.0,
    "use_maxpool": true,
    "encoder_layers": [
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 7,
        "stride": 2,
        "padding": 3,
        "_comment": "32x32x3 -> MaxPool(2) -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 7,
        "stride": 2,
        "padding": 3,
        "_comment": "16x16x63 -> MaxPool(2) -> 8x8x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 5,
        "kernel_size": 7,
        "stride": 2,
        "padding": 3,
        "_comment": "8x8x63 -> MaxPool(2) -> 4x4x63"
      },
      {
        "layer_type": "taxonomic_conv",
        "n_layers": 4,
        "kernel_size": 7,
        "stride": 1,
        "padding": 3,
        "_comment": "4x4x63 -> 4x4x31 (BOTTLENECK: 4x4x31=496 values, ~6x compression)"
      }
    ],
    "decoder_layers": [
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 7,
        "stride": 2,
        "padding": 3,
        "output_padding": 1,
        "_comment": "4x4x31 -> 8x8x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 7,
        "stride": 2,
        "padding": 3,
        "output_padding": 1,
        "_comment": "8x8x63 -> 16x16x63"
      },
      {
        "layer_type": "taxonomic_deconv",
        "n_layers": 5,
        "kernel_size": 7,
        "stride": 2,
        "padding": 3,
        "output_padding": 1,
        "_comment": "16x16x63 -> 32x32x63, then final conv to 32x32x3"
      }
    ]
  },
  "training": {
    "epochs": 30,
    "learning_rate": 0.001
  },
  "analysis": {
    "checkpoint_path": "outputs/cifar10/training/large_kernel_k7/final_model.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3
  },
  "output": {
    "training_save_dir": "outputs/cifar10/training/large_kernel_k7",
    "analysis_save_dir": "outputs/cifar10/analysis/large_kernel_k7"
  }
}
