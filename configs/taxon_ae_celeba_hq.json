{
  "experiment_name": "taxon_ae_celeba_hq_r18",
  "data": {
    "data_root": "./data/celeba_hq",
    "image_size": 256,
    "batch_size": 32,
    "num_workers": 8,
    "val_split": 0.05
  },
  "model": {
    "in_channels": 3,
    "resnet_variant": "18",
    "stage_taxonomy_layers": [5, 6, 7, 8],
    "stage_strides": [1, 2, 2, 2],
    "stage_blocks": null,
    "temperature": 0.5,
    "hard": false,
    "kernel_size": 3,
    "use_stem": true,
    "stem_channels": 64,
    "stem_stride": 2,
    "use_stem_maxpool": true,
    "output_activation": "none",
    "depth_decay": 0.5
  },
  "training": {
    "epochs": 90,
    "learning_rate": 3e-4,
    "weight_decay": 1e-4,
    "warmup_epochs": 3,
    "dkl_weight": 1e-2,
    "entropy_weight": 0.0,
    "save_every": 5,
    "seed": 42,
    "max_train_steps": 0
  },
  "analysis": {
    "checkpoint_path": "./outputs/taxon_ae_celeba_hq_r18/checkpoints/best.pt",
    "num_latent_batches": 50,
    "num_reconstruction_batches": 20,
    "num_multiple_recon_images": 8,
    "num_reconstructions_per_image": 8,
    "num_activation_images": 3,
    "num_taxonomy_batches": 10
  },
  "output": {
    "output_dir": "./outputs/taxon_ae_celeba_hq_r18",
    "analysis_save_dir": "./outputs/taxon_ae_celeba_hq_r18/analysis"
  }
}
